def isBalanced(s):
    stack = []
    bracket_map = {')': '(', '}': '{', ']': '['}
    
    for char in s:
        if char in bracket_map.values():  
            stack.append(char)
        elif char in bracket_map.keys(): 
            if not stack or stack[-1] != bracket_map[char]:
                return "NO"
            stack.pop()
        else:
            return "NO" 
    
    return "YES" if not stack else "NO"


print(isBalanced("{[()]}"))  
print(isBalanced("{[(])}"))  
